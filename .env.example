# --- Models -------------------------------------------------------------------
# Fallback model for every agent whose routed model is unavailable, in CrewAI's
# "provider/model" format. Examples: anthropic/claude-sonnet-5-5, openai/<model>,
# openrouter/<vendor>/<model>, ollama/<model>
MODEL=

# Set the keys for the providers you use. A model whose key is missing is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OpenAI-compatible providers (Models page -> Model catalogs)
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
# Local models (Ollama): OLLAMA_API_BASE=http://localhost:11434
# llama-server / LM Studio / vLLM: add a model with a base URL on the Models page.

# Let agents run the Claude Code / Codex CLIs inside their worktrees (off by default).
# Claude Code uses your `claude` login (subscription) unless ANTHROPIC_API_KEY is set.
ENABLE_CLAUDE_CODE=0
ENABLE_CODEX=0

# auto = use the Model Router; offline = deterministic simulator, no model calls.
EXECUTOR=auto

# --- Loop and quality gate -----------------------------------------------------
MAX_ITERATIONS=3
MAX_PARALLEL=3
# Work that passes the gate waits for an administrator's approval before merging.
REQUIRE_APPROVAL=1
# Default quality commands, separated by ";;" (a goal can set its own).
QUALITY_COMMANDS=
COMMAND_TIMEOUT=600
# Commands that already failed before the agents started do not block the gate.
ALLOW_PREEXISTING_FAILURES=0
# Per-goal budgets (0 = none): model spend in USD and wall-clock seconds.
GOAL_BUDGET_USD=0
GOAL_TIME_BUDGET=0
# When a budget runs out: pause (wait for an administrator) or stop (fail the goal).
BUDGET_EXHAUSTED_ACTION=pause
# Hours a goal may wait for approval before it shows as a project blocker (0 = never).
APPROVAL_BLOCKER_HOURS=24

# --- Proposals and GitHub --------------------------------------------------------
# Who decides proposals agents raise: user (an administrator) or superiors (the GM).
PROPOSAL_POLICY=user
# Goals one goal (and its descendants) may spawn through approved proposals.
MAX_PROPOSAL_GOALS=3
# Push approved work to the project's GitHub URL automatically.
AUTO_PUSH=0

# --- Research ------------------------------------------------------------------
# All of these (and more) can also be changed on the Settings page; saved values win.

# Seconds between rotation visits of the external-data room (0 = only on demand).
ROTATION_INTERVAL=0
# ALLOW_PRIVATE_CRAWL=1   # allow crawling private/loopback addresses

# --- Server and storage --------------------------------------------------------
HOST=127.0.0.1
PORT=4900
# Reach it from other computers through nginx (HTTPS by default, see transport.py):
# PORT=4910
# PUBLIC_PORT=4900
# MANAGE_NGINX=1
# TRANSPORT=https
# TLS_HOSTS=dashboard.example.com
# DATA_DIR=./data
# PostgreSQL instead of SQLite (run `uv sync --extra postgres` first):
# DATABASE_URL=postgresql+psycopg://agentuser:<password>@localhost:5432/agentapp
