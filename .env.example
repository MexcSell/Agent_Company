# Model used by every agent, in LiteLLM "provider/model" format.
# Examples: anthropic/claude-sonnet-5-5, openai/<model-name>, ollama/<model-name>
MODEL=

# Set the key that matches the provider above.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only for Ollama (local models).
# OLLAMA_API_BASE=http://localhost:11434
