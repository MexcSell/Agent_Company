# --- Models -------------------------------------------------------------------
# Fallback model for every agent whose routed model is unavailable, in CrewAI's
# "provider/model" format. Examples: anthropic/claude-sonnet-5-5, openai/<model>,
# openrouter/<vendor>/<model>, ollama/<model>
MODEL=

# Set the keys for the providers you use. A model whose key is missing is skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Local models (Ollama): OLLAMA_API_BASE=http://localhost:11434

# Let agents run the Claude Code / Codex CLIs inside their worktrees (off by default).
# Claude Code uses your `claude` login (subscription) unless ANTHROPIC_API_KEY is set.
ENABLE_CLAUDE_CODE=0
ENABLE_CODEX=0

# auto = use the Model Router; offline = deterministic simulator, no model calls.
EXECUTOR=auto

# --- Loop and quality gate -----------------------------------------------------
MAX_ITERATIONS=3
MAX_PARALLEL=3
# Work that passes the gate waits for an administrator's approval before merging.
REQUIRE_APPROVAL=1
# Default quality commands, separated by ";;" (a goal can set its own).
QUALITY_COMMANDS=
COMMAND_TIMEOUT=600

# --- Research ------------------------------------------------------------------
# Seconds between rotation visits of the external-data room (0 = only on demand).
ROTATION_INTERVAL=0
# ALLOW_PRIVATE_CRAWL=1   # allow crawling private/loopback addresses

# --- Server and storage --------------------------------------------------------
HOST=127.0.0.1
PORT=4900
# DATA_DIR=./data
# PostgreSQL instead of SQLite (run `uv sync --extra postgres` first):
# DATABASE_URL=postgresql+psycopg://agentuser:<password>@localhost:5432/agentapp
